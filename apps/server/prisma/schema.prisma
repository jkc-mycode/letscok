generator client {
  provider     = "prisma-client" // Prisma 7 신규 제너레이터 (prisma-client-js 대체)
  output       = "../src/generated/prisma"
  moduleFormat = "cjs" // NestJS(CommonJS) 호환
}

datasource db {
  provider = "postgresql"
  // url은 prisma.config.ts에서 설정 (Prisma 7부터 스키마 내 url 미지원)
}

enum Grade {
  A
  B
  C
  D
  E
  F
}

enum SessionStatus {
  OPEN
  CLOSED
}

enum CourtStatus {
  IDLE
  IN_GAME
}

enum AttendanceStatus {
  CHECKED_IN // 미배정 대기
  MATCHED // 4인 조합에 포함되어 코트 대기
  PLAYING // 게임 중
  LEFT // 퇴장 (재입장 시 CHECKED_IN 복귀)
}

enum GameStatus {
  QUEUED // 대기 조합 (코트 미배정)
  PLAYING
  FINISHED
  CANCELED // 조합 해체
}

// 회원 원장 — 세션과 무관하게 누적되는 기본 정보
model Member {
  id        String    @id @default(cuid())
  name      String
  birthDate DateTime  @db.Date // 동명이인 구분용으로 검색 결과에 노출
  grade     Grade
  isGuest   Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime? // soft-delete

  attendances Attendance[]

  @@index([name])
  @@map("members")
}

// 모임 1회 (하루) — 동시 진행 세션 없음, 항상 최대 1개 OPEN (세션 시작 API에서 보장)
model Session {
  id       String        @id @default(cuid())
  date     DateTime      @db.Date
  status   SessionStatus @default(OPEN)
  openedAt DateTime      @default(now())
  closedAt DateTime?

  courts      Court[]
  attendances Attendance[]
  games       Game[]

  @@index([status])
  @@map("sessions")
}

// 세션에 등록된 코트 (체육관 실제 코트 번호 사용)
model Court {
  id        String      @id @default(cuid())
  sessionId String
  courtNo   Int
  status    CourtStatus @default(IDLE)
  createdAt DateTime    @default(now())

  session Session @relation(fields: [sessionId], references: [id])
  games   Game[]

  @@unique([sessionId, courtNo]) // 같은 세션에 같은 번호 코트 중복 등록 방지
  @@map("courts")
}

// 세션 출석 — 하루 상태(대기/배정/게임/퇴장)와 카운터의 단위
model Attendance {
  id           String           @id @default(cuid())
  sessionId    String
  memberId     String
  status       AttendanceStatus @default(CHECKED_IN)
  checkedInAt  DateTime         @default(now())
  waitingSince DateTime         @default(now()) // 게임 종료·재입장 시 갱신
  gamesPlayed  Int              @default(0) // FINISHED 트랜잭션에서 증가
  leftAt       DateTime?

  session     Session      @relation(fields: [sessionId], references: [id])
  member      Member       @relation(fields: [memberId], references: [id])
  gamePlayers GamePlayer[]

  @@unique([sessionId, memberId]) // 하루 1인 1출석 — 재입장은 새 행이 아니라 이 행을 CHECKED_IN으로 되돌림
  @@index([sessionId, status]) // 보드 3구역 조회(상태별 필터)가 가장 빈번한 쿼리
  @@map("attendances")
}

// 4인 게임 1건 — QUEUED(대기 조합) 상태에서는 courtId null
model Game {
  id         String     @id @default(cuid())
  sessionId  String
  courtId    String?
  status     GameStatus @default(QUEUED)
  queuedAt   DateTime   @default(now())
  startedAt  DateTime?
  endedAt    DateTime?
  queueOrder Int? // 대기 조합 정렬 순서

  session Session      @relation(fields: [sessionId], references: [id])
  court   Court?       @relation(fields: [courtId], references: [id])
  players GamePlayer[]

  @@index([sessionId, status])
  @@map("games")
}

// 게임 참여자 (게임당 4행)
model GamePlayer {
  id           String @id @default(cuid())
  gameId       String
  attendanceId String

  game       Game       @relation(fields: [gameId], references: [id])
  attendance Attendance @relation(fields: [attendanceId], references: [id])

  @@unique([gameId, attendanceId]) // 같은 게임에 같은 사람 중복 투입 방지
  @@index([attendanceId]) // "이 사람이 참여한 게임" 역방향 조회용
  @@map("game_players")
}
