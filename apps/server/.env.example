# Neon Postgres 연결 문자열 (로컬 개발은 로컬 Postgres 사용 가능)
DATABASE_URL="postgresql://user:password@localhost:5432/letscok"

# (배포 전용) 마이그레이션용 direct 연결 — Neon pooled URL로는 migrate가 P1002로 실패
# 로컬은 불필요. Render에는 -pooler 없는 문자열을 넣는다
# DIRECT_DATABASE_URL=""

# 운영진 공유 패스코드 (환경변수 1개 방식 확정)
ADMIN_PASSCODE="change-me"

# 서버 포트 (Render는 PORT를 자동 주입)
PORT=4000

# CORS 허용 오리진 (콤마 구분) — 로컬 웹은 3001 (3000은 MAKi 서버가 사용)
CORS_ORIGINS="http://localhost:3001"

# Sentry 에러 수집 (비우면 비활성 — 로컬 개발 기본은 끔)
# SENTRY_DSN=""

# 웹 푸시 (셋 다 있어야 활성, 비우면 비활성) — 키 생성: pnpm dlx web-push generate-vapid-keys
# ⚠️ 키를 바꾸면 기존 구독이 전부 무효가 되므로 한 번 정하면 유지한다
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:you@example.com"
